{
  "manifest_version": 3,
  "name": "Proyectos Eleven",
  "version": "1.1.1",
  "description": "Mantiene al día tu app Proyectos Eleven: lee AppSheet y el Reporte de Seguimiento con tu sesión, solo lectura.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Proyectos Eleven"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.appsheet.com/*",
    "https://datastudio.google.com/*",
    "https://lookerstudio.google.com/*",
    "https://proyectos-eleven.martinbotana.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://proyectos-eleven.martinbotana.workers.dev/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.appsheet.com/*",
        "https://datastudio.google.com/*",
        "https://lookerstudio.google.com/*"
      ],
      "js": [
        "auto.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
